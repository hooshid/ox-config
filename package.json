{
  "name": "@hooshid/ox-config",
  "version": "0.1.0",
  "description": "Shared Oxlint + Oxfmt presets — one install for lint and format.",
  "license": "MIT",
  "author": "hooshid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hooshid/ox-config.git"
  },
  "homepage": "https://github.com/hooshid/ox-config#readme",
  "bugs": {
    "url": "https://github.com/hooshid/ox-config/issues"
  },
  "keywords": [
    "oxlint",
    "oxfmt",
    "lint",
    "format",
    "preset",
    "config"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./format": {
      "types": "./dist/format.d.mts",
      "import": "./dist/format.mjs"
    },
    "./lint": {
      "types": "./dist/lint.d.mts",
      "import": "./dist/lint.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.6",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "defu": "^6.1.7",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-react-refresh": "^0.5.7",
    "oxlint-tsgolint": "^0.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.44.0",
    "oxlint": ">=1.59.0"
  },
  "engines": {
    "node": ">=20"
  }
}